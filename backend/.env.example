NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_manager

REDIS_HOST=localhost
REDIS_PORT=6379

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Task Manager <no-reply@taskmanager.local>
EMAIL_WORKER_CONCURRENCY=5
MAILHOG_UI_PORT=8025

UPLOAD_DIR=uploads
LOG_LEVEL=info

TASK_WORKER_CONCURRENCY=5
# Optional test-only override (ms) for the fake 5–10s delay. Leave unset normally.
# TASK_WORKER_DELAY_MS=

MAX_UPLOAD_FILES=5
MAX_UPLOAD_FILE_MB=5
IMAGE_WORKER_CONCURRENCY=3

SOCKET_CORS_ORIGIN=*
